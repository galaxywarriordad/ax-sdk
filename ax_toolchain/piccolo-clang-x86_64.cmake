if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  if(MSVC OR CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC")
    target_compile_options(ax_core PRIVATE
      /clang:-O3
      /clang:-march=x86-64-v3
    )
    if(AX_SDK_ENABLE_WARNINGS)
      target_compile_options(ax_core PRIVATE /W4)
      if(AX_SDK_WERROR)
        target_compile_options(ax_core PRIVATE /WX)
      endif()
    endif()
  else()
    target_compile_options(ax_core PRIVATE
      -O3
      -march=x86-64-v3
    )
    if(AX_SDK_ENABLE_WARNINGS)
      target_compile_options(ax_core PRIVATE -Wall -Wextra -Wpedantic)
      if(AX_SDK_WERROR)
        target_compile_options(ax_core PRIVATE -Werror)
      endif()
    endif()
  endif()
elseif(MSVC)
  if(AX_SDK_ENABLE_WARNINGS)
    target_compile_options(ax_core PRIVATE /W4)
    if(AX_SDK_WERROR)
      target_compile_options(ax_core PRIVATE /WX)
    endif()
  endif()
else()
  if(AX_SDK_ENABLE_WARNINGS)
    target_compile_options(ax_core PRIVATE -Wall -Wextra -Wpedantic)
    if(AX_SDK_WERROR)
      target_compile_options(ax_core PRIVATE -Werror)
    endif()
  endif()
endif()
